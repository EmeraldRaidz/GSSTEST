min_delivery_order: 100.00
pickup_note: Check in at the front office and we will bring your order out.
timezone: America/New_York
# Category buttons appear in this order. A category used by a product but missing here is added at the end.
categories: Frozen Foods | Dry Goods | Paper Products | Beverages | Dairy & Refrigerated | Condiments & Sauces | Spices & Seasonings | Canned & Jarred | Grains & Baking | Oils & Syrups | Cleaning Supplies | Disposables & Packaging
# The Whitehall Market banner under the menu on every page. Set market_show: no to hide it.
# market_address is searched on Google Maps. Put the market's exact street address here.
# market_link (optional) overrides it with a full Google Maps link, e.g. a "Share" link from Maps.
market_show: yes
market_title: Whitehall Market
market_text: Check out our new state-of-the-art market in Whitehall.
market_address: Whitehall Market, Whitehall, NY 12887
market_link:
market_link_text: Get directions
# Map pin (approximate, adjust if needed)
lat: 43.5545
lon: -73.4040
hours: Mon | 08:00 | 17:00
hours: Tue | 08:00 | 17:00
hours: Wed | 08:00 | 17:00
hours: Thu | 08:00 | 17:00
hours: Fri | 08:00 | 17:00
hours: Sat | 08:00 | 17:00
hours: Sun | closed

