window.VGS = `
# ============================================================
#  orders.vgs  -  Green Mountain Food Services catalog file
# ============================================================
#  The website's JavaScript reads this file and builds every page from it.
#  - Lines starting with # are comments.
#  - [business] holds store details (Help page, Delivery page, checkout, footer).
#  - [product] starts a new product. Copy a block to add more.
#    "code" is the item number customers can search for (keep it unique).
#  - [slide] blocks make the picture carousel on the home page (warehouse, trucks, products).
#    "image:" uses a picture name from [images]. Blank shows a colored placeholder.
#  - "categories" in [business] sets the order the category buttons appear in.
#  - Each line is  key: value   (spec and hours can repeat; use | between parts).
#  - IMAGES: put picture files in the Web/images/ folder.
#    Products: type the file name right in the product, e.g.  image: maple-syrup.jpg
#    Slides: use a name from [images] below, e.g.  image: truckPic
#    A full link (https://...) also works. Leave it blank and the emoji is shown instead.
#  - Keep the first line (window.VGS = and the backtick) and the last line (backtick and ;)
#    exactly as they are. Do not type backticks, backslashes or dollar-brace in the text.
# ============================================================

[images]
# Home page carousel pictures, listed as   name: file
# Put the picture files in the folder below (Web/images/), then change a file name here
# and the website uses the new file everywhere that name is used.
# Slides point at a name with  image: truckPic  (names are not case sensitive).
# Product pictures are set inside each [product] instead, e.g.  image: maple-syrup.jpg
# A missing file is fine: the website shows the emoji or colored placeholder instead.
# Any picture type works: .jpg .jpeg .png .webp .gif .svg .avif .bmp - just type the real
# file name, e.g.  truckPic: truck.png  (iPhone .heic and .tiff files will not show in most
# browsers - save them as .jpg or .png first).
image_folder: images/
# Home page carousel
warehousePic: wear1.jpg
truckPic: truck1.jpg
productsPic: wear2.webp

[business]
name: Green Mountain Food Services
address: 4 Smith St
city: Whitehall, NY 12887
phone: (518) 499-9101
tollfree: (800) 323-5524
# Please confirm this is the right help email before going live
email: mo@gmfservice.com
delivery: eastern New York, Vermont, New Hampshire and Massachusetts
# Delivery pricing (placeholders - set your real numbers)
delivery_fee: 25.00
